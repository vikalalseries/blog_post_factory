# =============================================================================
# Blog Post Factory - environment template
#
# HOW TO USE
#   1. Copy this file to a new file named exactly ".env" (same folder, no .example):
#        Windows PowerShell:  Copy-Item .env.example .env
#        Mac / Linux:         cp .env.example .env
#   2. Open .env and paste your own keys after each "=" (no quotes, no spaces).
#   3. Restart the server (uvicorn server:app --reload) so the new values load.
#
# NEVER commit ".env" or share your keys. ".env" is git-ignored; this example
# file is safe to commit because it contains no real keys.
# =============================================================================


# --- REQUIRED: Gemini (the AI model that researches, writes and edits) --------
# Get a free key at https://aistudio.google.com/apikey  ->  "Create API key"
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which Gemini model to use (the default is fine for the free tier)
# GEMINI_MODEL=gemini-3.5-flash-lite


# --- REQUIRED: SerpAPI (Google web search used by the Researcher agent) -------
# Sign up at https://serpapi.com  ->  Dashboard -> "Your Private API Key".
# The free plan has a small monthly quota.
SERPAPI_API_KEY=your-serpapi-key-here

# Optional: max web searches per blog post (protects your free quota)
# MAX_SEARCHES=3


# --- OPTIONAL: Deepgram (voice typing with the microphone button) -------------
# Sign up at https://console.deepgram.com  ->  API Keys -> "Create a New API Key".
# Without it everything works except the mic button.
DEEPGRAM_API_KEY=your-deepgram-api-key-here


# --- OPTIONAL: Vercel Blob (saving posts when deployed on Vercel) -------------
# Only needed on Vercel, where the disk is read-only. Locally, posts are saved
# in the "output/" folder and you can leave these two lines out.
# In Vercel: your project -> Storage -> create a Blob store -> copy the values.
# BLOB_READ_WRITE_TOKEN=your-blob-read-write-token-here
# BLOB_STORE_ID_STORE_ID=your-blob-store-id-here
# "public" (default) or "private", must match how the store was created
# BLOB_ACCESS=public
